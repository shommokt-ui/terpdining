OPENAI_API_KEY=sk-proj-...
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=langsmith-demo
LANGSMITH_TRACING=true

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# CORS: comma-separated list of allowed origins for the deployed frontend
# and mobile app (capacitor://localhost and http://localhost are included
# by default for the packaged mobile app, no need to repeat them here).
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Used to build the password-reset link sent by email
FRONTEND_BASE_URL=https://your-frontend.example.com

# Password reset email (Resend). Leave blank to just log the reset link
# locally instead of sending an email.
RESEND_API_KEY=re_...
RESEND_FROM=TerpDining <onboarding@resend.dev>

# Set to "false" to disable the in-process daily menu re-scrape (e.g. if
# you're running the scraper separately).
ENABLE_SCRAPE_SCHEDULER=true
